        "arquitectura", "architecture", "design review", "tech lead", "sync",
        "kickoff", "kick-off", "roadmap", "entrevista", "interview",
        "onboarding", "mentoria", "mentoría", "feedback", "comite", "comité"
      ]
    },
    "it_soporte": {
      "keywords": [
        "incidente", "incident", "outage", "caida", "caída", "postmortem",
        "post-mortem", "soporte", "support", "guardia", "on-call", "oncall",
        "mantenimiento", "maintenance", "deploy", "release", "migracion",
        "migración", "infra", "infraestructura", "acceso", "permisos",
        "proveedor", "vendor", "ticket", "helpdesk"
